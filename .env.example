# Example environment variables for jwt-auth-django
# Copy this file to ".env" and fill with real values before running the project.

# Django
DJANGO_SECRET_KEY=replace-me-with-a-secure-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database
# For development with SQLite (default) you can leave DATABASE_URL empty or remove it.
# For production with PostgreSQL, use: postgresql://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3

# CORS (comma-separated list)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT settings (optional - settings.py already defines defaults)
# ACCESS_TOKEN_LIFETIME_MINUTES=15
# REFRESH_TOKEN_LIFETIME_DAYS=7
ACCESS_TOKEN_LIFETIME_MINUTES=15
REFRESH_TOKEN_LIFETIME_DAYS=7

# Email (for password reset / verification)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=your-email-password-or-app-password

# Security overrides (be careful when enabling in production)
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_BROWSER_XSS_FILTER=True
SECURE_CONTENT_TYPE_NOSNIFF=True

# Additional settings you might add in production
# REDIS_URL=redis://127.0.0.1:6379/1
# SENTRY_DSN=
# AWS_S3_BUCKET_NAME=

# NOTES:
# - Keep this file out of version control in production. Add ".env" to .gitignore.
# - Generate a strong DJANGO_SECRET_KEY (e.g. python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())").
# - Set DEBUG=False in production and configure ALLOWED_HOSTS accordingly.
